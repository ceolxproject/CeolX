# apps/web — environment variable reference
# VITE_ vars are bundled into browser JS — never put secrets here.
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT are build-time only (not sent to browser).

VITE_API_BASE_URL=http://localhost:3001
VITE_STRIPE_PUBLISHABLE_KEY=

# Sentry DSN is safe to expose — it is write-only (events in, no data out)
VITE_SENTRY_DSN=

# Build-time only — used by @sentry/vite-plugin to upload source maps on production builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ceolx
SENTRY_PROJECT=ceolx-admin
