{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo build --filter={./apps/admin}...",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/.well-known/:path*", "destination": "https://api.ceolx.ie/.well-known/:path*" },
    { "source": "/post/:path*", "destination": "https://api.ceolx.ie/post/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"staging\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi"
}
