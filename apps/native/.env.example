# apps/native — environment variable reference
# Only EXPO_PUBLIC_ vars are bundled into the app and visible to users.
# Never put secrets here. All secrets live in apps/server.

EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry DSN is safe to expose — EXPO_PUBLIC_ vars are bundled into the app.
# Sentry DSNs are write-only (events in, no data out).
EXPO_PUBLIC_SENTRY_DSN=

# PostHog product analytics. Token is a public client key — safe to commit.
# Host must be the EU Cloud endpoint for GDPR compliance (Irish client).
# Analytics is disabled entirely when EXPO_PUBLIC_POSTHOG_KEY is unset, so
# Expo Go and fresh clones boot without it.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Set to "true" once session-replay masking has been verified on a non-prod project.
EXPO_PUBLIC_POSTHOG_REPLAY=false
