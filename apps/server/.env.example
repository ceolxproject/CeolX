# apps/server — environment variable reference
# This file is committed. It documents every variable the server needs.
# Do NOT put real values here.
#
# Setup:
#   1. Fill in apps/server/.env.development with real dev values
#   2. Run: envx copy -e development   (decrypts/copies to .env)
#   3. For staging/prod: fill .env.staging / .env.production then encrypt:
#      envx encrypt -e staging -s STAGING_SECRET

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Production/staging origins only — pipe-separated.
# Dev origins (localhost:3000, 3001, 8081, 19006) are auto-injected when NODE_ENV=development.
CORS_ALLOWED_ORIGINS=https://app.ceolx.ie|https://admin.ceolx.ie

GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
GOOGLE_OAUTH_CLIENT_SECRET=

APPLE_OAUTH_CLIENT_ID=ie.ceolx.app
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

POSTMARK_API_TOKEN=
POSTMARK_FROM_ADDRESS=hello@ceolx.ie
# Shared secret Postmark signs bounce + complaint webhooks with (HTTP Basic).
# Set the same value in Postmark dashboard → Settings → Webhooks → Authentication.
POSTMARK_WEBHOOK_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=

MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_VENUE_PRICE_ID=

SENTRY_DSN_API=
SENTRY_ORG=ceolx # must match your Sentry org slug exactly
SENTRY_ENVIRONMENT=development

# Upstash QStash — background job queue (serverless, Lambda-compatible)
# Get from: https://console.upstash.com/qstash → API Keys
QSTASH_TOKEN=                    # API token for publishing messages
QSTASH_CURRENT_SIGNING_KEY=      # Webhook signature verification (current)
QSTASH_NEXT_SIGNING_KEY=         # Webhook signature verification (rotation)
QSTASH_BASE_URL=                 # Public HTTPS URL of this webhook endpoint
                                 # e.g. https://api.ceolx.ie/api/webhooks/qstash
                                 # Local dev: use ngrok or npx @upstash/qstash-cli dev

# Typesense — in-memory geo search engine for map viewport queries
# Local dev: docker run -d -p 8108:8108 -v /tmp/typesense-data:/data typesense/typesense:29.0 --data-dir /data --api-key=dev-local-key --enable-cors
# Cloud: https://cloud.typesense.org → create cluster → API Keys
TYPESENSE_HOST=localhost          # Cloud: xxx.a1.typesense.net
TYPESENSE_API_KEY=dev-local-key  # Cloud: admin API key
TYPESENSE_PORT=8108              # Cloud: 443
TYPESENSE_PROTOCOL=http          # Cloud: https
