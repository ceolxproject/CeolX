# apps/server — development
# Encrypted as .env.development.gpg for version control.
# Run: envx copy -e development  (decrypts to .env)

NODE_ENV=development
# APP_ENV overrides NODE_ENV for transport/env-specific decisions.
# Leave unset locally (NODE_ENV=development drives SMTP).
# Vercel preview => APP_ENV=staging; Vercel production => APP_ENV=production.
# APP_ENV=staging
PORT=3001

# Database — local Docker (see docker-compose.yml)
DATABASE_URL=postgresql://ceolx:ceolx_local@localhost:5432/ceolx_dev
SMTP_HOST=localhost
SMTP_PORT=1025

# BetterAuth
BETTER_AUTH_SECRET=<BETTER_AUTH_SECRET>
BETTER_AUTH_URL=<BETTER_AUTH_URL>

# CORS — pipe-separated origins
CORS_ALLOWED_ORIGINS=https://app.ceolx.com|https://admin.ceolx.com|http://localhost:3000|http://localhost:8081|ceolx://

# OAuth — Google (use test credentials in dev)
GOOGLE_OAUTH_CLIENT_ID_IOS=<dev-ios-client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID_ANDROID=<dev-android-client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<dev-google-oauth-client-secret>

# OAuth — Apple (iOS only — skip in local dev, required for TestFlight+)
APPLE_OAUTH_CLIENT_ID=com.ceolx.app
APPLE_OAUTH_TEAM_ID=<apple-team-id>
APPLE_OAUTH_KEY_ID=<apple-key-id>
APPLE_OAUTH_PRIVATE_KEY=<apple-p8-private-key-single-line>

# Shared-post deep linking (apps/server/src/routes/app-links.ts + post-share.ts).
# Reuses APPLE_OAUTH_TEAM_ID above as the AASA App ID Prefix. Android SHA-256 is
# public (served in assetlinks.json); route falls back to the prod value if unset.
# Source: `eas credentials -p android` → keystore → SHA-256. The STAGING server
# must use the staging app's keystore SHA (different package + keystore).
ANDROID_SHA256_CERT_FINGERPRINT=
# Bundle id / Android package the AASA + assetlinks vouch for. Prod default is
# com.ceolx.app; set to com.ceolx.app.staging on the STAGING server.
MOBILE_BUNDLE_ID=
# Canonical origin for og:url on the /post page. Prod = https://ceolx.com;
# staging = the staging server's own Vercel URL.
PUBLIC_WEB_ORIGIN=
# Store links on the web fallback page. Optional — defaults derive the Play
# Store url from the package id and use an App Store search until the app ships.
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=

# Postmark — use dev server or Postmark sandbox
# POSTMARK_API_TOKEN is intentionally absent in local dev — Mailpit is used instead
POSTMARK_API_TOKEN=
POSTMARK_FROM_ADDRESS=noreply@ceolx.com
SMTP_HOST=localhost
SMTP_PORT=1025

# Firebase FCM — use dev Firebase project.
# FIREBASE_SERVICE_ACCOUNT_KEY is the full service-account JSON as a single-line string.
# Both vars optional locally — server silently no-ops FCM sends when unset (isFirebaseConfigured guard).
FIREBASE_PROJECT_ID=ceolx-dev
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"ceolx-dev",...}

# AWS S3 + CloudFront — use dev bucket
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=<dev-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<dev-aws-secret-access-key>
S3_BUCKET_NAME=ceolx-media-dev
CLOUDFRONT_DOMAIN=<dev-cloudfront-domain>.cloudfront.net

# Mux — use dev environment
MUX_TOKEN_ID=<dev-mux-token-id>
MUX_TOKEN_SECRET=<dev-mux-token-secret>
MUX_WEBHOOK_SECRET=<dev-mux-webhook-signing-secret>

# Stripe — test mode keys
STRIPE_SECRET_KEY=sk_test_<dev-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<dev-stripe-webhook-secret>
STRIPE_PRICE_MONTHLY=price_<dev-stripe-monthly-price-id>
STRIPE_PRICE_ANNUAL=price_<dev-stripe-annual-price-id>
# Venue visibility kill switch (M8-T0 O-08). Defaults to false; staging runs true.
VENUE_GATE_ENABLED=false

# Sentry — optional in local dev
SENTRY_DSN_API=https://9e5bd61ee5ce285201b7f8d571e27b83@o4511115981750272.ingest.de.sentry.io/4511116008620112
SENTRY_ORG=ceolx # must match your Sentry org slug exactly
SENTRY_ENVIRONMENT=development
QSTASH_TOKEN=eyJVc2VySUQiOiJiZGU5OTQxNS0wMjY3LTRjMDctYjU3Ni0yMzYzYWI1NmIzOTkiLCJQYXNzd29yZCI6ImVkYjA0NDllZTliNzRjYmI4Njc0NTcyODgzMTUyYzM2In0=                    # API token for publishing messages
QSTASH_CURRENT_SIGNING_KEY=sig_7TP16Y6VceKJceN5Z8CSi4Y56fLE      # Webhook signature verification (current)
QSTASH_NEXT_SIGNING_KEY=sig_6XEDvsTFEUQne3NAbi1QM7gLbgKE         # Webhook signature verification (rotation)
QSTASH_BASE_URL=https://qstash-eu-central-1.upstash.io            # QStash SERVICE endpoint (regional). NOT our webhook — the destination is derived from BETTER_AUTH_URL + /api/webhooks/qstash
TYPESENSE_HOST=localhost
TYPESENSE_API_KEY=dev-local-key
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http