{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "api/index.js", "api/_chunks/**"],
      "env": [
        "ENABLE_EXPERIMENTAL_COREPACK",
        "NODE_ENV",
        "APP_ENV",
        "ADMIN_EMAIL",
        "ADMIN_PASSWORD",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ALLOWED_ORIGINS",
        "POSTMARK_API_TOKEN",
        "POSTMARK_FROM_ADDRESS",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "RATE_LIMIT_ENABLED",
        "RATE_LIMIT_IP_ALLOWLIST",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "APPLE_OAUTH_CLIENT_ID",
        "APPLE_OAUTH_TEAM_ID",
        "APPLE_OAUTH_KEY_ID",
        "APPLE_OAUTH_PRIVATE_KEY",
        "ANDROID_SHA256_CERT_FINGERPRINT",
        "MOBILE_BUNDLE_ID",
        "PUBLIC_WEB_ORIGIN",
        "IOS_APP_STORE_URL",
        "ANDROID_PLAY_STORE_URL",
        "SENTRY_DSN_API",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ORG",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_VENUE_PRICE_ID",
        "QSTASH_TOKEN",
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "QSTASH_BASE_URL",
        "TYPESENSE_HOST",
        "TYPESENSE_API_KEY",
        "TYPESENSE_PORT",
        "TYPESENSE_PROTOCOL",
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "S3_BUCKET_NAME",
        "CLOUDFRONT_DOMAIN",
        "MUX_TOKEN_ID",
        "MUX_TOKEN_SECRET",
        "MUX_WEBHOOK_SECRET",
        "FIREBASE_PROJECT_ID",
        "FIREBASE_SERVICE_ACCOUNT_KEY"
      ]
    }
  }
}
