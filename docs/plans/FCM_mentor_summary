  8. Mobile client integration
                              
  Two files:
                                                                                                                                   
  apps/mobile/lib/notifications.ts
                                                                                                                                   
  Uses expo-notifications but pulls the native token, not an Expo push token:                                                      
                                               
  const tokenData = await Notifications.getDevicePushTokenAsync();  // native FCM/APNs                                             
  const token = tokenData.data;                                                                                                    
                                               
  await client.fcmTokens.register({                                                                                                
    token,                                                    
    deviceType: Platform.OS === "ios" ? "ios" : "android",
    deviceName: Device.modelName ?? undefined,                                                                                     
  });
                                                                                                                                   
  This means the same firebase-admin server path delivers to mobile — no Expo push service involved.                               
                                               
  Other helpers in this file:                                                                                                      
  - configureNotificationHandler() — sets foreground display behaviour.
  - registerForPushNotificationsAsync() — full flow: permission prompt → record osPermissionStatus for analytics → Android channel 
  setup → fetch token → register.                                                                                                 
  - refreshPushTokenAsync() — called on every app launch.                                                                          
  - unregisterPushToken() / deactivateAllTokens() — logout cleanup.
  - shouldPromptForPermission() — checks server-side cooldown (30-day after denial, max 3 prompts total).                          
                                                                                                                                   
  apps/mobile/app/_layout.tsx — PushNotificationSetup component                                                                    
                                                                                                                                   
  Reactive integration with the auth session. On useSession() change:                                                              
  - Logged out (was logged in) → deactivateAllTokens().
  - Same user, fresh launch → refreshPushTokenAsync().
  - New user logged in → registerForPushNotificationsAsync() with exponential-backoff retry (5s → 10s → … capped at 60s) for transient failures. "denied" is a hard stop
  (no retry), while null is treated as transient.

  const attemptRegistration = async (retryDelayMs: number) => {
    const result = await registerForPushNotificationsAsync();
    if (result === "denied") return;            // hard stop
    if (result) { registeredUserId.current = userId; return; }
    retryTimer.current = setTimeout(
      () => void attemptRegistration(Math.min(retryDelayMs * 2, 60_000)),
      retryDelayMs
    );
  };

