# =============================================================================
# CeolX — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in values for local development.
# Each GitHub Environment (dev / staging / prod) has its own secrets.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL — branch-specific)
# Each git branch tracks its own Neon DB branch:
#   main   → production DB
#   staging → staging DB
#   dev    → dev DB
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/ceolx?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/ceolx?sslmode=require

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Authentication (BetterAuth)
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=<32-char-random-secret>
BETTER_AUTH_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# OAuth — Google Sign-In
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID_IOS=<ios-client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID_ANDROID=<android-client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>

# -----------------------------------------------------------------------------
# OAuth — Apple Sign-In (iOS only — App Store required)
# -----------------------------------------------------------------------------
APPLE_OAUTH_CLIENT_ID=ie.ceolx.app
APPLE_OAUTH_TEAM_ID=<apple-team-id>
APPLE_OAUTH_KEY_ID=<apple-key-id>
APPLE_OAUTH_PRIVATE_KEY=<apple-p8-private-key>

# -----------------------------------------------------------------------------
# Transactional Email (Postmark)
# -----------------------------------------------------------------------------
POSTMARK_API_TOKEN=<postmark-server-api-token>
POSTMARK_FROM_ADDRESS=noreply@ceolx.ie

# -----------------------------------------------------------------------------
# Push Notifications (Firebase FCM)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=ceolx-prod
FIREBASE_PRIVATE_KEY=<firebase-service-account-private-key>
FIREBASE_CLIENT_EMAIL=<firebase-service-account-email>

# -----------------------------------------------------------------------------
# Media Storage (AWS S3 + CloudFront)
# -----------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
S3_BUCKET_NAME=ceolx-media
CLOUDFRONT_DOMAIN=<cloudfront-distribution-domain>.cloudfront.net

# -----------------------------------------------------------------------------
# Video Processing (Mux)
# -----------------------------------------------------------------------------
MUX_TOKEN_ID=<mux-token-id>
MUX_TOKEN_SECRET=<mux-token-secret>
MUX_WEBHOOK_SECRET=<mux-webhook-signing-secret>

# -----------------------------------------------------------------------------
# Payments (Stripe — web-only, no in-app billing)
# Venue subscriptions via ceolx.ie/subscribe only (Apple Rule 3.1.1)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_<stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=pk_test_<stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=whsec_<stripe-webhook-secret>
STRIPE_VENUE_PRICE_ID=price_<stripe-price-id>

# -----------------------------------------------------------------------------
# Maps
# Google Maps API key (Android) — Apple Maps needs no key (iOS)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=<google-maps-android-api-key>
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=<google-maps-android-api-key>

# -----------------------------------------------------------------------------
# API Rate Limiting (DynamoDB — not needed in local dev)
# Uses in-memory Map when NODE_ENV=development
# -----------------------------------------------------------------------------
AWS_DYNAMODB_RATE_LIMIT_TABLE=ceolx-rate-limits

# -----------------------------------------------------------------------------
# CORS (pipe-separated list of allowed browser origins)
# Development origins are always added automatically when NODE_ENV=development
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://admin.ceolx.ie|https://app.ceolx.ie

# -----------------------------------------------------------------------------
# Sentry (Error Tracking)
# -----------------------------------------------------------------------------
SENTRY_DSN_API=<sentry-dsn-for-ceolx-api>
SENTRY_DSN_ADMIN=<sentry-dsn-for-ceolx-admin>
SENTRY_AUTH_TOKEN=<sentry-auth-token-for-sourcemap-upload>

# -----------------------------------------------------------------------------
# App Config
# -----------------------------------------------------------------------------
NODE_ENV=development
