{
  "name": "@CeolX/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:check": "tsx --env-file ../../apps/server/.env src/check.ts",
    "db:seed": "tsx --env-file ../../apps/server/.env src/seed.ts",
    "db:seed-map-demo": "tsx --env-file ../../apps/server/.env src/seed-map-demo.ts",
    "db:seed-events-galway": "tsx --env-file ../../apps/server/.env src/seed-galway.ts",
    "db:seed-posts": "tsx --env-file ../../apps/server/.env src/seed-posts.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose -f ../../docker-compose.yml up -d",
    "db:watch": "docker compose -f ../../docker-compose.yml up",
    "db:stop": "docker compose -f ../../docker-compose.yml stop",
    "db:down": "docker compose -f ../../docker-compose.yml down"
  },
  "dependencies": {
    "@CeolX/env": "workspace:*",
    "@CeolX/shared": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.17.1",
    "typesense": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@CeolX/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "catalog:",
    "typescript": "^5"
  }
}
